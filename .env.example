# Copy to .env and fill in. Never commit .env.

# --- Used in M1 ---
# Folder with chairs/ (photos), manuals/ (PDFs) and state/ (runtime). Default: ./data
TAGALONG_DATA_DIR=
HOST=0.0.0.0
PORT=8000
# Public base URL for the QR on the printed card, e.g. https://xyz.trycloudflare.com
# Empty = the URL the request came in on.
PUBLIC_BASE_URL=

# --- Pipeline (python -m pipeline) ---
STAGE_TIMEOUT=40          # seconds per LLM call
LLM_PROVIDER=offline      # gemini | anthropic | openai | offline (default)
LLM_MODEL=                # required for gemini, anthropic, openai
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=          # any OpenAI-compatible endpoint

# --- Not read yet (live mode in the web app, DESIGN §4) ---
MODE=saved                # live | saved
LIVE_KEY=                 # presenter opens pages with ?live=<LIVE_KEY>
