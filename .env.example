# Copy to .env and fill in. Never commit .env.

# --- Used in M1 ---
# Folder with chairs/ (photos), manuals/ (PDFs) and state/ (runtime). Default: ./data
TAGALONG_DATA_DIR=
HOST=0.0.0.0
PORT=8000
# Public base URL for the QR on the printed card, e.g. https://xyz.trycloudflare.com
# Empty = the URL the request came in on.
PUBLIC_URL=

# --- Read from M2 on (LLM pipeline, DESIGN §4) ---
MODE=saved                # live | saved
LIVE_KEY=                 # presenter opens pages with ?live=<LIVE_KEY>
STAGE_TIMEOUT=40          # seconds per stage before falling back to the saved result
LLM_PROVIDER=anthropic    # anthropic | gemini | openai
LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=          # any OpenAI-compatible endpoint
